# Price Tracker configuration example.
# Copy this file to .env and adjust values for your machine.
# .env is ignored by Git and must never be committed.

# --- Application ---------------------------------------------------------
PT_APP_NAME=Price Tracker
PT_APP_HOST=127.0.0.1
PT_APP_PORT=8000
PT_APP_DEBUG=false
PT_PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Paths ---------------------------------------------------------------
# Relative paths are resolved from the directory where the app is started.
PT_DATA_DIR=data
PT_LOG_DIR=logs
# Optional SQLite URL override. Only SQLite is supported in v1.0.
# PT_DATABASE_URL=sqlite+pysqlite:///./data/price_tracker.db

# --- Security ------------------------------------------------------------
# Leave empty to generate a persistent secret in data/.secret on first run.
PT_SECRET_KEY=
# JSON list syntax is required for list values.
PT_ALLOWED_HOSTS=["127.0.0.1","localhost"]
PT_ALLOWED_PORTS=[80,443]

# --- Logging -------------------------------------------------------------
PT_LOG_LEVEL=INFO

# --- Monitoring ----------------------------------------------------------
# Minimum allowed interval is 300 seconds.
PT_CHECK_INTERVAL_SECONDS=3600
PT_RECENT_DECREASE_DAYS=7

# --- Scraper -------------------------------------------------------------
PT_SCRAPER_TIMEOUT_MS=30000
PT_SCRAPER_CONCURRENCY=2
PT_SCRAPER_MIN_DELAY_SECONDS=2.0
PT_SCRAPER_MAX_RESPONSE_BYTES=5000000
PT_SCRAPER_USER_AGENT=PriceTracker/0.1 (local portfolio project)

# --- Notifications -------------------------------------------------------
PT_NOTIFICATION_COOLDOWN_HOURS=24
PT_MAX_NOTIFICATION_ATTEMPTS=3

# Email is automatically disabled at startup when required SMTP values
# are missing. Console notifications remain available.
PT_EMAIL_ENABLED=true
PT_SMTP_HOST=
PT_SMTP_PORT=587
PT_SMTP_SECURITY=starttls
PT_SMTP_USERNAME=
PT_SMTP_PASSWORD=
PT_SMTP_FROM=
PT_SMTP_TO=
PT_SMTP_TIMEOUT_SECONDS=15
